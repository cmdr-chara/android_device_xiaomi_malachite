cc_library_shared {
    name: "dolbycodec_shim",
    srcs: ["dolbycodec_shim.c"],
    vendor: true,
}

cc_library_shared {
    name: "libultrahdr_shim",
    srcs: ["libultrahdr_shim.cpp"],
    compile_multilib: "64",
    shared_libs: [
        "libjpeg",
        "libultrahdr",
    ],
    vendor: true,
}
