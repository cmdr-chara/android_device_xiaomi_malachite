allow hal_graphics_composer_default sysfs_gpu:file rw_file_perms;
allow hal_graphics_composer_default sysfs_leds:file rw_file_perms;
allow hal_graphics_composer_default vendor_hal_displayfeature_xiaomi:binder transfer;
allow hal_graphics_composer_default vendor_displayfeature_device:chr_file { ioctl open read };
allow hal_graphics_composer_default proc_ged:chr_file { ioctl open read };
get_prop(hal_graphics_composer_default, vendor_displayfeature_prop)
set_prop(hal_graphics_composer_default, vendor_displayfeature_prop)
hal_client_domain(hal_graphics_composer_default, vendor_hal_displayfeature_xiaomi)
r_dir_file(hal_graphics_composer_default, sysfs_leds)
rw_dir_file(hal_graphics_composer_default, sysfs_ged)
