cc_binary {
    name: "android.hardware.audio.service.malachite",
    overrides: ["android.hardware.audio.service"],
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    init_rc: ["android.hardware.audio.service.malachite.rc"],
    srcs: ["service.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
        "android.hardware.soundtrigger3-V3-ndk",
    ],
}
