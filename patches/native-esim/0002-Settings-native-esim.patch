 import com.android.settings.network.telephony.euicc.EuiccRepository
@@ -62,6 +63,7 @@ fun SimsSection(subscriptionInfoList: List<SubscriptionInfo>) {
             SimPreference(subInfo)
         }
 
+        SimSlotSelection()
         AddSim()
     }
 }
@@ -130,6 +132,21 @@ fun phoneNumber(subInfo: SubscriptionInfo): State<String?> {
     }.collectAsStateWithLifecycle(initialValue = null)
 }
 
+@Composable
+private fun SimSlotSelection() {
+    val context = LocalContext.current
+    if (!EsimSlotSelection.isSupported(context)) return
+    RestrictedPreference(
+        model = object : PreferenceModel {
+            override val title = stringResource(R.string.esim_slot_selection_title)
+            override val summary = { context.getString(R.string.esim_slot_selection_summary) }
+            override val icon = @Composable { SettingsIcon(Icons.Outlined.SimCard) }
+            override val onClick = { context.startActivity(EsimSlotSelection.intent()) }
+        },
+        restrictions = Restrictions(keys = listOf(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS)),
+    )
+}
+
 @Composable
 private fun AddSim() {
     val context = LocalContext.current
