diff --git a/src/com/android/settings/network/telephony/EsimSlotSelection.kt b/src/com/android/settings/network/telephony/EsimSlotSelection.kt
new file mode 100644
index 00000000000..7f40d23ce43
--- /dev/null
+++ b/src/com/android/settings/network/telephony/EsimSlotSelection.kt
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.network.telephony
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.UserManager
+import android.telephony.euicc.EuiccManager
+import com.android.settings.R
+import com.android.settings.Utils
+
+/** Entry into the existing phone service; Settings never owns the modem callback. */
+object EsimSlotSelection {
+    const val PREFERENCE_KEY = "esim_slot_selection"
+    private const val EXTRA_SELECTION_ONLY = "com.android.phone.euicc.extra.SHOW_SIM_SELECTION"
+
+    fun isSupported(context: Context): Boolean =
+        context.resources.getBoolean(R.bool.config_mtk_euicc_slot_switch) &&
+            context.packageManager.hasSystemFeature(PackageManager.FEATURE_TELEPHONY_EUICC) &&
+            context.getSystemService(UserManager::class.java)?.isAdminUser == true
+
+    fun intent(): Intent =
+        Intent(EuiccManager.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)
+            .setPackage(Utils.PHONE_PACKAGE_NAME)
+            .putExtra(EXTRA_SELECTION_ONLY, true)
+}
