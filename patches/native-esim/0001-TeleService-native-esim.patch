diff --git a/src/com/android/phone/euicc/EsimStatus.java b/src/com/android/phone/euicc/EsimStatus.java
new file mode 100644
index 000000000..be63afc00
--- /dev/null
+++ b/src/com/android/phone/euicc/EsimStatus.java
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.phone.euicc;
+
+import java.io.IOException;
+
+/** Parser shared by the read and select responses in Xiaomi's MIPC protocol. */
+final class EsimStatus {
+    private EsimStatus() {}
+
+    static int parse(String[] values) throws IOException {
+        if (values == null || values.length != 1 || values[0] == null) {
+            throw new IOException("Malformed modem response");
+        }
+        String first = values[0].split(",", -1)[0].trim();
+        if (!first.matches("-?[0-9]{1,2}")) throw new IOException("Malformed modem status");
+        return Integer.parseInt(first);
+    }
+}
diff --git a/src/com/android/phone/euicc/EuiccSlotSelectionActivity.java b/src/com/android/phone/euicc/EuiccSlotSelectionActivity.java
new file mode 100644
index 000000000..5b41e7940
--- /dev/null
+++ b/src/com/android/phone/euicc/EuiccSlotSelectionActivity.java
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.phone.euicc;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.telecom.TelecomManager;
+import android.telephony.TelephonyManager;
+import android.telephony.UiccCardInfo;
+import android.telephony.euicc.EuiccManager;
+import android.util.Log;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.android.phone.R;
+
+import java.io.IOException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Internal preparation of the shared SIM connection before the standard eUICC UI. */
+public final class EuiccSlotSelectionActivity extends Activity {
+    static final String EXTRA_SELECTION_ONLY = "com.android.phone.euicc.extra.SHOW_SIM_SELECTION";
+    private static final String EXTRA_TARGET = "com.android.phone.euicc.extra.TARGET_UI";
+    private static final String TAG = "EuiccSlotSelection";
+    private static final ExecutorService WORKER = Executors.newSingleThreadExecutor();
+    private Model mModel;
+    private Intent mTarget;
+    private TextView mStatus;
+    private TextView mMessage;
+    private Button mToggle;
+    private Button mRefresh;
+    private Button mManage;
+    private final Runnable mObserver = this::render;
+
+    static boolean isSupported(Context context) {
+        return context.getResources().getBoolean(R.bool.config_mtk_euicc_slot_switch)
+                && context.getPackageManager().hasSystemFeature(
+                        PackageManager.FEATURE_TELEPHONY_EUICC);
+    }
+
+    static Intent createIntent(Context context, Intent target) {
+        return new Intent(context, EuiccSlotSelectionActivity.class).putExtra(EXTRA_TARGET, target)
+                .addFlags(Intent.FLAG_ACTIVITY_FORWARD_RESULT);
+    }
+
+    @Override public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!isSupported(this) || !mayChange(this)) {
+            setResult(RESULT_CANCELED);
+            finish();
+            return;
+        }
+        mTarget = getIntent().getParcelableExtra(EXTRA_TARGET, Intent.class);
+        // Only the permission-protected dispatcher can start this non-exported activity.
+        if (mTarget != null && mTarget.getComponent() == null) {
+            finish();
+            return;
+        }
+        setTitle(R.string.esim_slot_title);
+        if (getActionBar() != null) getActionBar().setDisplayHomeAsUpEnabled(true);
+        LinearLayout content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        int padding = Math.round(24 * getResources().getDisplayMetrics().density);
+        content.setPadding(padding, padding, padding, padding);
+        mStatus = new TextView(this);
+        mStatus.setTextSize(22);
+        content.addView(mStatus);
+        mMessage = new TextView(this);
+        mMessage.setTextSize(16);
+        mMessage.setPadding(0, padding, 0, padding);
+        content.addView(mMessage);
+        mToggle = button(content, R.string.esim_slot_use_embedded);
+        mToggle.setOnClickListener(view -> confirmSwitch());
+        mManage = button(content, R.string.esim_slot_manage);
+        mManage.setOnClickListener(view -> {
+            if (mTarget == null) {
+                startActivity(new Intent(EuiccManager.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)
+                        .setPackage(getPackageName()));
+            } else {
+                mModel.read();
+            }
+        });
+        mRefresh = button(content, R.string.esim_slot_refresh);
+        mRefresh.setOnClickListener(view -> mModel.read());
+        setContentView(content);
+        mModel = (Model) getLastNonConfigurationInstance();
+        if (mModel == null) {
+            mModel = new Model(getApplicationContext(), mTarget != null);
+            mModel.read();
+        }
+        render();
+    }
+
+    @Override public Object onRetainNonConfigurationInstance() { return mModel; }
+
+    @Override protected void onStart() {
+        super.onStart();
+        if (mModel != null) {
+            mModel.observer = mObserver;
+            render();
+        }
+    }
+
+    @Override protected void onStop() {
+        if (mModel != null && mModel.observer == mObserver) mModel.observer = null;
+        super.onStop();
+    }
+
+    @Override public boolean onNavigateUp() { finish(); return true; }
+
+    private Button button(LinearLayout parent, int title) {
+        Button button = new Button(this);
+        button.setText(title);
+        button.setFilterTouchesWhenObscured(true);
+        parent.addView(button, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return button;
+    }
+
+    private static boolean mayChange(Context context) {
+        UserManager users = context.getSystemService(UserManager.class);
+        return users != null && users.isAdminUser()
+                && !users.hasUserRestriction(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS);
+    }
+
+    private static boolean callIsActive(Context context) {
+        TelecomManager telecom = context.getSystemService(TelecomManager.class);
+        return telecom == null || telecom.isInCall();
+    }
+
+    private void confirmSwitch() {
+        if (mModel.busy || (mModel.selection != 0 && mModel.selection != 1)) return;
+        if (!mayChange(this) || callIsActive(this)) {
+            mMessage.setText(!mayChange(this) ? R.string.esim_slot_restricted
+                    : R.string.esim_slot_call_active);
+            return;
+        }
+        boolean embedded = mModel.selection == 0;
+        AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle(embedded ? R.string.esim_slot_use_embedded : R.string.esim_slot_use_physical)
+                .setMessage(embedded ? R.string.esim_slot_confirm_embedded
+                        : R.string.esim_slot_confirm_physical)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.esim_slot_confirm,
+                        (confirmation, which) -> mModel.select(embedded))
+                .create();
+        dialog.setOnShowListener(shown -> dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                .setFilterTouchesWhenObscured(true));
+        dialog.show();
+    }
+
+    private void render() {
+        if (mModel == null || isFinishing() || isDestroyed()) return;
+        mStatus.setText(mModel.busy ? (mModel.switching ? R.string.esim_slot_switching
+                : R.string.esim_slot_reading) : mModel.selection == 1 ? R.string.esim_slot_embedded
+                : mModel.selection == 0 ? R.string.esim_slot_physical : R.string.esim_slot_unknown);
+        mMessage.setText(mModel.error == 0 ? R.string.esim_slot_explanation : mModel.error);
+        mToggle.setText(mModel.selection == 1 ? R.string.esim_slot_use_physical
+                : R.string.esim_slot_use_embedded);
+        mToggle.setEnabled(!mModel.busy && (mModel.selection == 0 || mModel.selection == 1));
+        mRefresh.setEnabled(!mModel.busy);
+        mManage.setEnabled(!mModel.busy && mModel.selection == 1);
+        if (mModel.dispatchReady && mTarget != null && hasWindowFocus()) {
+            mModel.dispatchReady = false;
+            mTarget.setFlags(Intent.FLAG_ACTIVITY_FORWARD_RESULT);
+            startActivityAsUser(mTarget, UserHandle.CURRENT);
+            finish();
+        }
+    }
+
+    @Override public void onWindowFocusChanged(boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if (hasFocus) render();
+    }
+
+    /** Retained across rotation; the worker owns no Activity or profile identifiers. */
+    private static final class Model {
+        private final Context context;
+        private final boolean continueToManager;
+        private final Handler main = new Handler(Looper.getMainLooper());
+        private int selection = -1;
+        private int error;
+        private boolean busy;
+        private boolean switching;
+        private boolean dispatchReady;
+        private Runnable observer;
+
+        Model(Context context, boolean continueToManager) {
+            this.context = context;
+            this.continueToManager = continueToManager;
+        }
+
+        void read() { run(false, false); }
+        void select(boolean embedded) { run(true, embedded); }
+
+        private void run(boolean change, boolean embedded) {
+            if (busy) return;
+            busy = true;
+            switching = change;
+            dispatchReady = false;
+            error = 0;
+            notifyObserver();
+            WORKER.execute(() -> {
+                int state = -1;
+                int failure = 0;
+                boolean ready = false;
+                try {
+                    if (!mayChange(context)) {
+                        failure = R.string.esim_slot_restricted;
+                    } else if (change && callIsActive(context)) {
+                        failure = R.string.esim_slot_call_active;
+                    } else {
+                        MtkEsimTransport transport = MtkEsimTransport.getInstance();
+                        if (change) transport.select(embedded,
+                                () -> mayChange(context) && !callIsActive(context));
+                        state = transport.readState();
+                        Log.i(TAG, (change ? "switch_state=" : "read_state=") + state);
+                        if (state != 0 && state != 1) {
+                            failure = R.string.esim_slot_read_error;
+                        } else if (state == 1 && (change || continueToManager)) {
+                            ready = waitForEuicc();
+                            if (!ready) failure = R.string.esim_slot_card_error;
+                        }
+                    }
+                } catch (IOException failureDetail) {
+                    Log.w(TAG, "transport_failed=" + failureDetail.getMessage());
+                    failure = change ? R.string.esim_slot_switch_error : R.string.esim_slot_read_error;
+                    if (change) {
+                        try { state = MtkEsimTransport.getInstance().readState(); }
+                        catch (IOException ignored) { /* Leave an unknown selection unknown. */ }
+                    }
+                } catch (RuntimeException failureDetail) {
+                    Log.w(TAG, "state_unavailable=" + failureDetail.getClass().getSimpleName());
+                    failure = R.string.esim_slot_read_error;
+                }
+                final int actual = state;
+                final int errorResource = failure;
+                final boolean cardReady = ready;
+                main.post(() -> {
+                    selection = actual;
+                    error = errorResource;
+                    busy = false;
+                    dispatchReady = continueToManager && cardReady && error == 0;
+                    notifyObserver();
+                });
+            });
+        }
+
+        private boolean waitForEuicc() {
+            TelephonyManager telephony = context.getSystemService(TelephonyManager.class);
+            if (telephony == null) return false;
+            long deadline = SystemClock.elapsedRealtime() + 20_000;
+            do {
+                for (UiccCardInfo card : telephony.getUiccCardsInfo()) {
+                    if (card.getPhysicalSlotIndex() == 1 && card.isEuicc()
+                            && card.getEid() != null && !card.getEid().isEmpty()
+                            && card.getPorts().stream().anyMatch(port -> port.isActive())) {
+                        Log.i(TAG, "euicc_ready=true");
+                        return true;
+                    }
+                }
+                SystemClock.sleep(250);
+            } while (SystemClock.elapsedRealtime() < deadline);
+            Log.w(TAG, "euicc_ready=false");
+            return false;
+        }
+
+        private void notifyObserver() {
+            if (observer != null) observer.run();
+        }
+    }
+}
