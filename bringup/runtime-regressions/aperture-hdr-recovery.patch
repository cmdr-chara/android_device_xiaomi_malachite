--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/models/VideoRecoveryPolicy.kt
@@ -0,0 +1,20 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.models
+
+/** Pure selection rules shared by initial configuration and failed HDR recovery. */
+internal object VideoRecoveryPolicy {
+    // A null frame rate means CameraX chooses it. Never replace AUTO with the
+    // first fixed rate: advertised frame rates need not work with every HDR mode.
+    fun <T> frameRate(requested: T?, supported: Set<T>): T? =
+        requested?.takeIf { it in supported }
+
+    fun <T> fallbackQuality(requested: T, sdrQualities: Set<T>): T? =
+        requested.takeIf { it in sdrQualities } ?: sdrQualities.firstOrNull()
+
+    fun canRecover(isHdr: Boolean, isIdle: Boolean, isCurrent: Boolean): Boolean =
+        isHdr && isIdle && isCurrent
+}
