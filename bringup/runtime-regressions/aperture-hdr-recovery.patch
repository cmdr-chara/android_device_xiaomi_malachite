+    /**
+     * Retry an unsupported HDR session once as SDR. A second failure is not
+     * retried, because the current configuration will already be SDR.
+     * Only stream-configuration failures may call this; permission, device,
+     * encoder and unrelated runtime errors must retain their normal handling.
+     */
+    fun recoverFromHdrVideoFailure(failedConfiguration: CameraConfiguration? = null): Boolean {
+        val current = _cameraConfiguration.value as? CameraConfiguration.Video ?: return false
+        if (!VideoRecoveryPolicy.canRecover(
+                current.videoDynamicRange != VideoDynamicRange.SDR,
+                canRestartCamera(),
+                failedConfiguration == null || failedConfiguration == current,
+            )
+        ) {
+            return false
+        }
+        val sdrQualities = current.camera.supportedVideoQualities.filterValues {
+            VideoDynamicRange.SDR in it.supportedDynamicRanges
+        }.keys
+        val quality = VideoRecoveryPolicy.fallbackQuality(current.videoQuality, sdrQualities)
+            ?: return false
+
+        // Commit the small recovery record before rebinding. A process exit
+        // during the fallback must not leave the failed HDR preference behind.
+        if (!preferencesRepository.resetVideoToSdr(quality)) {
+            Log.e(LOG_TAG, "Could not persist the SDR recovery configuration")
+            return false
+        }
+        return updateConfiguration<CameraConfiguration.Video> {
+            it.copy(
+                videoQuality = quality,
+                videoDynamicRange = VideoDynamicRange.SDR,
+                videoFrameRate = null,
+                enableVideoStabilization = false,
+            )
+        }
+    }
