<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">3.0px</dimen>

    <!-- the padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">3.0px</dimen>

    <!-- the padding on the top of the statusbar (usually 0) -->
    <dimen name="status_bar_padding_top">14.0px</dimen>

    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height_portrait</dimen>

    <dimen name="rounded_corner_content_padding">56px</dimen>

    <dimen name="keyguard_indication_margin_bottom">8dp</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item format="float" name="pixel_pitch" type="dimen">57.0</item>

    <!-- Blur radius behind Notification Shade -->
    <dimen name="max_shade_window_blur_radius">22dp</dimen>
</resources>
